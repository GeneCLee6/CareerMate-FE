# Base URL of the CareerMate-BE API (note the /v1 prefix).
REACT_APP_API_BASE_URL=http://localhost:3000/v1

# EmailJS credentials for the landing page contact form.
# Copy this file to .env.local and fill in your own values.
REACT_APP_EMAILJS_PUBLIC_KEY=
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
